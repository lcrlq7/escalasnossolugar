# Copie para .env e preencha. Estas duas chaves são PÚBLICAS por design (protegidas por RLS).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# NUNCA coloque chaves privadas (service_role, YouTube, Spotify) no frontend.
# Segredos de integrações ficam nos "Secrets" das Edge Functions do Supabase
# (YOUTUBE_API_KEY, SPOTIFY_CLIENT_ID, SPOTIFY_CLIENT_SECRET) — veja o README.

# Opcional: chave PÚBLICA (site key) do hCaptcha. Se definida, login/cadastro/recuperação exibem o captcha.
# O captcha precisa estar ligado no Supabase (Authentication → Attack Protection) com o secret correspondente.
# VITE_HCAPTCHA_SITEKEY=
